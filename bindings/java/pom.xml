<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.truespar</groupId>
    <artifactId>siftx</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>SiftX</name>
    <description>Cross-platform document and image processing library - Java bindings</description>
    <url>https://github.com/truespar/siftx</url>

    <!-- Dual-licensed: a consumer may take either, at their option. -->
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>6.1.3</junit.version>
        <!-- Overridden per runner in the release build; these defaults let a
             local `mvn package` bundle the library cargo just produced. -->
        <siftx.native.os>linux</siftx.native.os>
        <siftx.native.arch>x86_64</siftx.native.arch>
    </properties>

    <profiles>
        <profile>
            <id>mac</id>
            <activation><os><family>mac</family></os></activation>
            <properties><siftx.native.os>darwin</siftx.native.os></properties>
        </profile>
        <profile>
            <id>windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties><siftx.native.os>windows</siftx.native.os></properties>
        </profile>
        <profile>
            <id>aarch64</id>
            <activation><os><arch>aarch64</arch></os></activation>
            <properties><siftx.native.arch>aarch64</siftx.native.arch></properties>
        </profile>
        <profile>
            <id>arm64</id>
            <activation><os><arch>arm64</arch></os></activation>
            <properties><siftx.native.arch>aarch64</siftx.native.arch></properties>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            Native libraries are bundled under /native/<os>-<arch>/ and
            extracted at runtime by Native.java, so a Maven consumer does not
            have to install anything.

            src/main/resources/native/ is populated by the release build, which
            collects one library per platform from its own runner. For a local
            build only the host's library exists (or none at all), and that is
            fine: the JAR simply carries fewer platforms, and the developer
            path through SIFTX_NATIVE_LIB_PATH still works.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../../target/release</directory>
                <targetPath>native/${siftx.native.os}-${siftx.native.arch}</targetPath>
                <includes>
                    <include>libsiftx.so</include>
                    <include>libsiftx.dylib</include>
                    <include>siftx.dll</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
